/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; script-src 'self' 'unsafe-inline' 'unsafe-eval' 'wasm-unsafe-eval' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com; connect-src 'self' https://cdn.jsdelivr.net; img-src 'self' data: blob:; font-src 'self' data: https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://fonts.gstatic.com; worker-src 'self' blob:; frame-src 'self'

# 应用 Shell：关缓存，改版即时生效
/static/index.html
  Cache-Control: no-cache

# 可长期缓存的 vendored wheels（内容固定）
/static/vendor/*
  Cache-Control: public, max-age=31536000, immutable

# 引擎源 + 字体子集：写进 wasm FS，内容稳定，短 cache 即可
# (每个 Path 一行 + 自己的 Header —— Cloudflare 把每个 path 行视为独立规则)
/diecut_engine.py
  Cache-Control: public, max-age=86400
/box_registry.py
  Cache-Control: public, max-age=86400
/diecut_schema.json
  Cache-Control: public, max-age=86400
/fonts/NotoSansSC-subset.ttf
  Cache-Control: public, max-age=86400
